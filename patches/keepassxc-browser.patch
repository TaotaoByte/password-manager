diff --git a/keepassxc-browser/popups/popup_functions.js b/keepassxc-browser/popups/popup_functions.js
index f7f61a6..0130e98 100644
--- a/keepassxc-browser/popups/popup_functions.js
+++ b/keepassxc-browser/popups/popup_functions.js
@@ -27,10 +27,24 @@ async function initSettings() {
     });
 }
 
+// A cold MV3 worker can take a moment to register its message listener.
+// Only use this for reads during popup startup.
+async function readPopupState(action) {
+    for (let attempt = 0; attempt < 9; ++attempt) {
+        try {
+            return await browser.runtime.sendMessage({ action });
+        } catch (error) {
+            if (attempt === 8 || !error.message?.includes('Receiving end does not exist')) {
+                logError(error);
+                return undefined;
+            }
+            await new Promise(resolve => setTimeout(resolve, 400));
+        }
+    }
+}
+
 async function initColorTheme() {
-    let theme = await browser.runtime.sendMessage({
-        action: 'get_color_theme'
-    });
+    let theme = await readPopupState('get_color_theme') ?? 'system';
     if (theme === 'system') {
         theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
     }
@@ -58,7 +72,5 @@ async function getLoginData(useBasicAuth = false) {
         document.addEventListener('DOMContentLoaded', initSettings);
     }
 
-    updateAvailableResponse(await browser.runtime.sendMessage({
-        action: 'update_available_keepassxc'
-    }));
+    updateAvailableResponse(await readPopupState('update_available_keepassxc'));
 })();
