@@ -214,3 +214,59 @@ code {
         color: var(--kpxc-text-color) !important;
     }
 }
+
+body.localvault.popup-shell {
+    width: 400px;
+    padding: 16px 4px 20px;
+}
+
+.popup-shell > .container { gap: 12px; }
+.popup-shell #popup-alerts:empty { display: none; }
+.popup-shell #popup-alerts { margin-top: 0; }
+.popup-shell .settings {
+    align-items: center;
+    gap: 8px;
+    border: 1px solid var(--lv-line);
+    border-radius: 20px;
+    padding: 10px;
+    margin: 0;
+    background: var(--lv-tint);
+}
+.localvault-popup-brand {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    margin: 0 auto 0 0;
+    font-size: 16px;
+    font-weight: 700;
+}
+.localvault-popup-mark {
+    display: grid;
+    place-items: center;
+    width: 32px;
+    height: 32px;
+    border-radius: 11px;
+    background: var(--lv-accent);
+    color: var(--lv-on-accent);
+}
+.popup-shell :is(.alert, .credentials, #initial-state, #not-configured,
+    #need-reconfigure, #configured-not-associated, #configured-and-associated,
+    #error-encountered, #database-not-opened, #username-field-detected) {
+    border: 1px solid var(--lv-line);
+    border-radius: 16px;
+    padding: 14px;
+    overflow-wrap: anywhere;
+}
+.popup-shell :is(.credentials, #initial-state, #not-configured, #need-reconfigure,
+    #configured-not-associated, #configured-and-associated, #error-encountered,
+    #database-not-opened, #username-field-detected) { background: var(--lv-surface); }
+.popup-shell .alert-dismissible { padding-inline-end: 44px; }
+.popup-shell .loader { border-top-color: var(--lv-accent); }
+.popup-shell #login-filter {
+    border: 1px solid var(--lv-line);
+    border-radius: 999px;
+    padding: 7px 12px;
+}
+.popup-shell .list-group-item { padding: 9px 12px !important; }
+.popup-shell .list-group { --bs-list-group-border-color: var(--lv-line); }
+.popup-shell button { min-height: 32px; }
