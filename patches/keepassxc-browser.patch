diff --git a/keepassxc-browser/css/localvault.css b/keepassxc-browser/css/localvault.css
new file mode 100644
index 0000000..eb9be4a
--- /dev/null
+++ b/keepassxc-browser/css/localvault.css
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+:root,
+[data-bs-theme="light"] {
+    --lv-canvas: #f2f6fc;
+    --lv-surface: #ffffff;
+    --lv-tint: #e6eefc;
+    --lv-line: #cbd8ec;
+    --lv-ink: #15243b;
+    --lv-muted: #475a75;
+    --lv-accent: #315cc0;
+    --lv-on-accent: #ffffff;
+}
+
+[data-bs-theme="dark"] {
+    --lv-canvas: #111827;
+    --lv-surface: #1a2436;
+    --lv-tint: #263752;
+    --lv-line: #435673;
+    --lv-ink: #edf2fa;
+    --lv-muted: #bdcbe1;
+    --lv-accent: #afc6ff;
+    --lv-on-accent: #122752;
+}
+
+@media (prefers-color-scheme: dark) {
+    :root:not([data-bs-theme="light"]) {
+        --lv-canvas: #111827;
+        --lv-surface: #1a2436;
+        --lv-tint: #263752;
+        --lv-line: #435673;
+        --lv-ink: #edf2fa;
+        --lv-muted: #bdcbe1;
+        --lv-accent: #afc6ff;
+        --lv-on-accent: #122752;
+    }
+}
+
+body.localvault {
+    --kpxc-background-color: var(--lv-canvas);
+    --kpxc-text-color: var(--lv-ink);
+    --kpxc-card-background-color: var(--lv-surface);
+    --kpxc-card-header-color: var(--lv-tint);
+    --kpxc-card-border-color: var(--lv-line);
+    --kpxc-input-background-color: var(--lv-surface);
+    --kpxc-input-main-border-color: var(--lv-line);
+    --kpxc-input-active-border-color: var(--lv-accent);
+    --kpxc-table-hover-color: var(--lv-tint);
+    --kpxc-link-color: var(--lv-accent);
+    --kpxc-link-hover-color: var(--lv-ink);
+    background: var(--lv-canvas);
+    color: var(--lv-ink);
+    font-family: system-ui, sans-serif;
+}
+
+.localvault .btn { border-radius: 999px; }
+.localvault .btn-primary,
+.localvault .btn-success {
+    --bs-btn-color: var(--lv-on-accent);
+    --bs-btn-bg: var(--lv-accent) !important;
+    --bs-btn-border-color: var(--lv-accent) !important;
+    --bs-btn-hover-bg: var(--lv-ink) !important;
+    --bs-btn-hover-border-color: var(--lv-ink) !important;
+    --bs-btn-hover-color: var(--lv-canvas);
+}
+.localvault :where(a, button, input, [tabindex]):focus-visible {
+    outline: 2px solid var(--lv-accent);
+    outline-offset: 2px;
+}
