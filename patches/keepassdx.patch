@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.kunzisoft.keepass.settings
+
+import java.util.Locale
+
+/** Device hints only; never changes credential matching or requests OEM permissions. */
+enum class DeviceSetupProfile {
+    XIAOMI, SAMSUNG, COLOROS, VIVO, GENERIC;
+
+    companion object {
+        fun forManufacturer(manufacturer: String, brand: String): DeviceSetupProfile {
+            val names = setOf(manufacturer, brand).map { it.trim().lowercase(Locale.ROOT) }
+            return when {
+                names.any { it in setOf("xiaomi", "redmi", "poco") } -> XIAOMI
+                "samsung" in names -> SAMSUNG
+                names.any { it in setOf("oppo", "oneplus", "realme") } -> COLOROS
+                names.any { it in setOf("vivo", "iqoo") } -> VIVO
+                else -> GENERIC
+            }
+        }
+    }
+}
