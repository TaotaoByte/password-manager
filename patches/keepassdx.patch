@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.kunzisoft.keepass.settings
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DeviceSetupProfileTest {
+    @Test fun recognizesOemAndBrandAliases() {
+        assertEquals(DeviceSetupProfile.XIAOMI, DeviceSetupProfile.forManufacturer("Xiaomi", "Redmi"))
+        assertEquals(DeviceSetupProfile.XIAOMI, DeviceSetupProfile.forManufacturer("unknown", " POCO "))
+        assertEquals(DeviceSetupProfile.SAMSUNG, DeviceSetupProfile.forManufacturer("SAMSUNG", "samsung"))
+        assertEquals(DeviceSetupProfile.COLOROS, DeviceSetupProfile.forManufacturer("OnePlus", "OnePlus"))
+        assertEquals(DeviceSetupProfile.COLOROS, DeviceSetupProfile.forManufacturer("OPPO", "realme"))
+        assertEquals(DeviceSetupProfile.VIVO, DeviceSetupProfile.forManufacturer("vivo", "iQOO"))
+    }
+
+    @Test fun unknownNamesUseGenericInstructions() {
+        assertEquals(DeviceSetupProfile.GENERIC, DeviceSetupProfile.forManufacturer("Google", "google"))
+        assertEquals(DeviceSetupProfile.GENERIC, DeviceSetupProfile.forManufacturer("", ""))
+        assertEquals(DeviceSetupProfile.GENERIC, DeviceSetupProfile.forManufacturer("not-xiaomi", "other"))
+    }
+}
