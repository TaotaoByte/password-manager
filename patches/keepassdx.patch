+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.kunzisoft.keepass.settings
+
+import android.provider.Settings
+import android.view.View
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.Button
+import com.kunzisoft.keepass.R
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [30, 34])
+class DeviceSetupActivityTest {
+    @Test fun serviceSelectionTargetsThisPackageAndActivityResumes() {
+        val controller = Robolectric.buildActivity(DeviceSetupActivity::class.java).setup()
+        val activity = controller.get()
+        assertTrue(activity.window.attributes.flags and WindowManager.LayoutParams.FLAG_SECURE != 0)
+        fun children(view: View): List<View> = listOf(view) +
+            if (view is ViewGroup) (0 until view.childCount).flatMap { children(view.getChildAt(it)) }
+            else emptyList()
+        val buttons = children(activity.window.decorView).filterIsInstance<Button>()
+        val choose = buttons.single { it.text == activity.getString(R.string.localvault_choose_service) }
+        choose.performClick()
+        val intent = shadowOf(activity).nextStartedActivity
+        assertEquals(Settings.ACTION_REQUEST_SET_AUTOFILL_SERVICE, intent.action)
+        assertEquals("package:${activity.packageName}", intent.data.toString())
+        controller.pause().resume()
+        assertTrue(choose.isEnabled)
+        controller.pause().stop().destroy()
+    }
+}
