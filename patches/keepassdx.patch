diff --git a/app/src/main/java/com/kunzisoft/keepass/settings/DeviceSetupActivity.kt b/app/src/main/java/com/kunzisoft/keepass/settings/DeviceSetupActivity.kt
new file mode 100644
index 0000000..aa25c1c
--- /dev/null
+++ b/app/src/main/java/com/kunzisoft/keepass/settings/DeviceSetupActivity.kt
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.kunzisoft.keepass.settings
+
+import android.content.ActivityNotFoundException
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.provider.Settings
+import android.view.WindowManager
+import android.view.autofill.AutofillManager
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import com.kunzisoft.keepass.R
+
+/** No vault access. Returning from system settings refreshes the calling package's status. */
+class DeviceSetupActivity : AppCompatActivity() {
+    private lateinit var status: TextView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        title = getString(R.string.localvault_setup_title)
+        val content = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            val padding = (20 * resources.displayMetrics.density).toInt()
+            setPadding(padding, padding, padding, padding)
+        }
+        val padding = (20 * resources.displayMetrics.density).toInt()
+        ViewCompat.setOnApplyWindowInsetsListener(content) { view, insets ->
+            val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
+            view.setPadding(padding + bars.left, padding + bars.top,
+                padding + bars.right, padding + bars.bottom)
+            insets
+        }
+        fun text(value: String): TextView = TextView(this).apply {
+            text = value
+            textSize = 16f
+            setPadding(0, 12, 0, 12)
+            content.addView(this)
+        }
+        fun button(label: Int, action: () -> Unit) {
+            content.addView(Button(this).apply {
+                setText(label)
+                setOnClickListener { action() }
+            })
+        }
+        text(getString(R.string.localvault_setup_title)).textSize = 22f
+        text(getString(R.string.localvault_device_info,
+            "${Build.MANUFACTURER} ${Build.MODEL}", Build.VERSION.RELEASE,
+            Build.VERSION.SDK_INT, Build.DISPLAY))
+        status = text("")
+        val profile = DeviceSetupProfile.forManufacturer(Build.MANUFACTURER, Build.BRAND)
+        text(getString(when (profile) {
+            DeviceSetupProfile.XIAOMI -> R.string.localvault_hint_xiaomi
+            DeviceSetupProfile.SAMSUNG -> R.string.localvault_hint_samsung
+            DeviceSetupProfile.COLOROS -> R.string.localvault_hint_coloros
+            DeviceSetupProfile.VIVO -> R.string.localvault_hint_vivo
+            DeviceSetupProfile.GENERIC -> R.string.localvault_hint_generic
+        }))
+        button(R.string.localvault_choose_service) {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                openSettings(Intent(Settings.ACTION_REQUEST_SET_AUTOFILL_SERVICE,
+                    Uri.parse("package:$packageName")))
+            } else {
+                Toast.makeText(this, R.string.localvault_autofill_unsupported, Toast.LENGTH_LONG).show()
+            }
+        }
+        button(R.string.localvault_fill_options) {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                startActivity(Intent(this, AutofillSettingsActivity::class.java))
+            }
+        }
+        button(R.string.localvault_app_settings) {
+            openSettings(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
+                Uri.parse("package:$packageName")))
+        }
+        text(getString(R.string.localvault_hint_browser))
+        text(getString(R.string.localvault_hint_limits))
+        button(R.string.localvault_back) { finish() }
+        setContentView(ScrollView(this).apply { addView(content) })
+    }
+
+    override fun onResume() {
+        super.onResume()
+        if (!::status.isInitialized) return
+        val enabled = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O &&
+            getSystemService(AutofillManager::class.java)?.hasEnabledAutofillServices() == true
+        status.setText(if (enabled) R.string.localvault_service_enabled else R.string.localvault_service_disabled)
+    }
+
+    private fun openSettings(intent: Intent) {
+        try {
+            startActivity(intent)
+        } catch (_: ActivityNotFoundException) {
+            try { startActivity(Intent(Settings.ACTION_SETTINGS)) }
+            catch (_: ActivityNotFoundException) {
+                Toast.makeText(this, R.string.localvault_settings_unavailable, Toast.LENGTH_LONG).show()
+            }
+        } catch (_: SecurityException) {
+            Toast.makeText(this, R.string.localvault_settings_unavailable, Toast.LENGTH_LONG).show()
+        }
+    }
+}
