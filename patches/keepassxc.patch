diff --git a/src/core/QuickSave.h b/src/core/QuickSave.h
new file mode 100644
index 0000000..8f245ae
--- /dev/null
+++ b/src/core/QuickSave.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef LOCALVAULT_QUICKSAVE_H
+#define LOCALVAULT_QUICKSAVE_H
+
+#include "core/Entry.h"
+#include <QRegularExpression>
+
+namespace QuickSave
+{
+    // Literal, anchored association: '*' and '?' in a window title are not wildcards.
+    inline void prepareEntry(Entry* entry, const QString& windowTitle)
+    {
+        entry->setTitle(windowTitle);
+        entry->setDefaultAutoTypeSequence(QStringLiteral("{USERNAME}{TAB}{PASSWORD}"));
+        if (!windowTitle.isEmpty()) {
+            entry->autoTypeAssociations()->add(
+                {QStringLiteral("//\\A") + QRegularExpression::escape(windowTitle) + QStringLiteral("\\z//"),
+                 QStringLiteral("{USERNAME}{TAB}{PASSWORD}")});
+        }
+    }
+}
+#endif
diff --git a/src/gui/QuickSaveController.h b/src/gui/QuickSaveController.h
new file mode 100644
index 0000000..82c1509
--- /dev/null
+++ b/src/gui/QuickSaveController.h
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef LOCALVAULT_QUICKSAVECONTROLLER_H
+#define LOCALVAULT_QUICKSAVECONTROLLER_H
+
+#ifdef Q_OS_WIN
+#include "core/Config.h"
+#include <QAbstractNativeEventFilter>
+#include <QApplication>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QKeySequenceEdit>
+#include <QLabel>
+#include <QMenu>
+#include <QMessageBox>
+#include <QTimer>
+#include <QVBoxLayout>
+#include <functional>
+#include <qt_windows.h>
+
+/** Only observes its registered hotkey; never hooks the keyboard or reads form values. */
+class QuickSaveController : public QObject, public QAbstractNativeEventFilter
+{
+public:
+    QuickSaveController(QWidget* owner, QMenu* menu, std::function<void(const QString&)> callback)
+        : QObject(owner), m_owner(owner), m_window(reinterpret_cast<HWND>(owner->winId())),
+          m_callback(std::move(callback))
+    {
+        qApp->installNativeEventFilter(this);
+        const auto shortcut = config()->get(Config::QuickSaveShortcut).toString();
+        if (!shortcut.isEmpty() && !registerShortcut(QKeySequence::fromString(shortcut, QKeySequence::PortableText))) {
+            QTimer::singleShot(0, this, [this] {
+                QMessageBox::warning(m_owner, QStringLiteral("快捷保存"),
+                    QStringLiteral("快捷保存热键无法注册，可能已被占用。请在“工具 → 快捷保存热键”中重新设置。"));
+            });
+        }
+        menu->addSeparator();
+        auto action = menu->addAction(QStringLiteral("快捷保存热键…"));
+        connect(action, &QAction::triggered, this, [this] { configure(); });
+    }
+
+    ~QuickSaveController() override
+    {
+        if (m_registered) UnregisterHotKey(m_window, m_hotkeyId);
+        qApp->removeNativeEventFilter(this);
+    }
+
+    bool nativeEventFilter(const QByteArray&, void* message, qintptr* result) override
+    {
+        const auto msg = static_cast<MSG*>(message);
+        if (!m_registered || msg->hwnd != m_window || msg->message != WM_HOTKEY
+            || int(msg->wParam) != m_hotkeyId) return false;
+        const auto target = GetForegroundWindow();
+        DWORD processId = 0;
+        GetWindowThreadProcessId(target, &processId);
+        if (target && processId != GetCurrentProcessId() && !QApplication::activeModalWidget()) {
+            wchar_t title[4096] = {};
+            const auto length = GetWindowTextW(target, title, 4096);
+            const auto windowTitle = QString::fromWCharArray(title, length);
+            QTimer::singleShot(0, this, [this, windowTitle] { m_callback(windowTitle); });
+        }
+        *result = 0;
+        return true;
+    }
+
+private:
+    bool registerShortcut(const QKeySequence& sequence)
+    {
+        if (sequence.count() != 1) return false;
+        const auto combination = sequence[0];
+        const auto key = combination.key();
+        const auto modifiers = combination.keyboardModifiers();
+        UINT nativeModifiers = MOD_NOREPEAT;
+        if (modifiers & Qt::ControlModifier) nativeModifiers |= MOD_CONTROL;
+        if (modifiers & Qt::AltModifier) nativeModifiers |= MOD_ALT;
+        if (modifiers & Qt::ShiftModifier) nativeModifiers |= MOD_SHIFT;
+        if (modifiers & Qt::MetaModifier) nativeModifiers |= MOD_WIN;
+        if (!(nativeModifiers & (MOD_CONTROL | MOD_ALT | MOD_WIN))) return false;
+        UINT nativeKey = 0;
+        if ((key >= Qt::Key_A && key <= Qt::Key_Z) || (key >= Qt::Key_0 && key <= Qt::Key_9)) {
+            nativeKey = UINT(key);
+        } else if (key >= Qt::Key_F1 && key <= Qt::Key_F24) {
+            nativeKey = VK_F1 + UINT(key - Qt::Key_F1);
+        } else {
+            return false;
+        }
+        if (m_registered && sequence == m_sequence) return true;
+        const auto newId = m_hotkeyId == 0x4C56 ? 0x4C57 : 0x4C56;
+        // Register first, so an invalid or occupied replacement retains the old binding.
+        if (!RegisterHotKey(m_window, newId, nativeModifiers, nativeKey)) return false;
+        if (m_registered) UnregisterHotKey(m_window, m_hotkeyId);
+        m_hotkeyId = newId;
+        m_registered = true;
+        m_sequence = sequence;
+        return true;
+    }
+
+    void configure()
+    {
+        QDialog dialog(m_owner);
+        dialog.setWindowTitle(QStringLiteral("快捷保存热键"));
+        auto layout = new QVBoxLayout(&dialog);
+        layout->addWidget(new QLabel(QStringLiteral("在其他软件中按此热键，录入并关联账号。\n"
+            "使用 Ctrl、Alt 或 Win 加字母、数字或 F1–F24；清空可禁用。"), &dialog));
+        auto editor = new QKeySequenceEdit(QKeySequence::fromString(
+            config()->get(Config::QuickSaveShortcut).toString(), QKeySequence::PortableText), &dialog);
+        layout->addWidget(editor);
+        auto buttons = new QDialogButtonBox(QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog);
+        layout->addWidget(buttons);
+        connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+        connect(buttons, &QDialogButtonBox::accepted, &dialog, [this, editor, &dialog] {
+            const auto sequence = editor->keySequence();
+            if (sequence.isEmpty()) {
+                if (m_registered) UnregisterHotKey(m_window, m_hotkeyId);
+                m_registered = false;
+            } else if (!registerShortcut(sequence)) {
+                QMessageBox::warning(&dialog, QStringLiteral("无法使用此热键"),
+                    QStringLiteral("热键已被占用或格式不支持，请重新选择。原热键保持有效。"));
+                return;
+            }
+            config()->set(Config::QuickSaveShortcut, sequence.toString(QKeySequence::PortableText));
+            dialog.accept();
+        });
+        dialog.exec();
+    }
+
+    QWidget* m_owner;
+    HWND m_window;
+    std::function<void(const QString&)> m_callback;
+    QKeySequence m_sequence;
+    int m_hotkeyId = 0x4C56;
+    bool m_registered = false;
+};
+#endif
+#endif
