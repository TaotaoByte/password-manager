+void TestEntry::testDefaultAutoTypeDoesNotSubmit()
+{
+    Database db;
+    auto entry = new Entry();
+    entry->setGroup(db.rootGroup());
+    entry->setUsername("test-user");
+    entry->setPassword("fictional-password");
+    QCOMPARE(entry->effectiveAutoTypeSequence(), QStringLiteral("{USERNAME}{TAB}{PASSWORD}"));
+    entry->setUsername({});
+    QCOMPARE(entry->effectiveAutoTypeSequence(), QStringLiteral("{PASSWORD}"));
+    entry->setUsername("test-user");
+    entry->setPassword({});
+    QCOMPARE(entry->effectiveAutoTypeSequence(), QStringLiteral("{USERNAME}"));
+    // An explicit existing user sequence remains compatible with old databases.
+    entry->setDefaultAutoTypeSequence("{USERNAME}{ENTER}");
+    QCOMPARE(entry->effectiveAutoTypeSequence(), QStringLiteral("{USERNAME}{ENTER}"));
+}
