+void DatabaseWidget::createEntryForWindow(const QString& windowTitle)
+{
+    // Use the existing pending-entry transaction: Cancel never inserts an entry.
+    if (isLocked() || currentMode() != Mode::ViewMode || !currentGroup() || isRecycleBinSelected()) {
+        return;
+    }
+    m_newEntry.reset(new Entry());
+    m_newEntry->setUuid(QUuid::createUuid());
+    m_newEntry->setUsername(m_db->metadata()->defaultUserName());
+    m_newParent = currentGroup();
+    m_newParent->applyGroupIconOnCreateTo(m_newEntry.data());
+    QuickSave::prepareEntry(m_newEntry.data(), windowTitle);
+    switchToEntryEdit(m_newEntry.data(), true);
+}
