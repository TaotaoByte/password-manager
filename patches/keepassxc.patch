+// SPDX-License-Identifier: GPL-2.0-or-later
+// Uses a private config and synthetic in-memory entries; never reads personal vaults.
+#include "gui/Application.h"
+#include "config-keepassx.h"
+#include "gui/MainWindow.h"
+#include "gui/WelcomeWidget.h"
+#include "gui/DatabaseTabWidget.h"
+#include "gui/entry/EntryView.h"
+#include "core/Config.h"
+#include "core/Database.h"
+#include "core/Group.h"
+#include "core/Metadata.h"
+#include "crypto/Crypto.h"
+#include "util/TemporaryFile.h"
+#include "keys/CompositeKey.h"
+#include "keys/PasswordKey.h"
+
+#include <QDir>
+#include <QLabel>
+#include <QLineEdit>
+#include <QListWidget>
+#include <QPushButton>
+#include <QSignalSpy>
+#include <QTest>
+#include <QToolBar>
+#include <QTranslator>
+
+class TestLocalVaultAppearance : public QObject
+{
+    Q_OBJECT
+private slots:
+    void initTestCase()
+    {
+        QVERIFY(Crypto::init());
+        Config::createConfigFromFile(TemporaryFile::createTempConfigFile(), {});
+        config()->set(Config::QuickSaveShortcut, QString());
+        config()->set(Config::GlobalAutoTypeKey, 0);
+        config()->set(Config::UpdateCheckMessageShown, true);
+        config()->set(Config::AutoSaveAfterEveryChange, false);
+        config()->set(Config::AutoSaveOnExit, false);
+        config()->set(Config::RememberLastDatabases, false);
+        config()->set(Config::Messages_HidePreReleaseWarning, KEEPASSXC_VERSION);
+        Application::bootstrap("zh_CN");
+        const auto translations = qEnvironmentVariable("LOCALVAULT_TRANSLATIONS_DIR");
+        if (!translations.isEmpty()) {
+            QVERIFY(m_translator.load("keepassxc_zh_CN", translations));
+            qApp->installTranslator(&m_translator);
+        }
+    }
+
+    void welcomeActionsAndRecentPaths()
+    {
+        const QString file = QDir::tempPath() + "/localvault-preview/Personal.kdbx";
+        config()->set(Config::LastDatabases, QStringList{file});
+        WelcomeWidget welcome;
+        welcome.show();
+        welcome.activateWindow();
+        QSignalSpy createSpy(&welcome, &WelcomeWidget::newDatabase);
+        QSignalSpy openSpy(&welcome, &WelcomeWidget::openDatabase);
+        QSignalSpy importSpy(&welcome, &WelcomeWidget::importFile);
+        QSignalSpy recentSpy(&welcome, &WelcomeWidget::openDatabaseFile);
+        QTest::mouseClick(welcome.findChild<QPushButton*>("buttonNewDatabase"), Qt::LeftButton);
+        QTest::mouseClick(welcome.findChild<QPushButton*>("buttonOpenDatabase"), Qt::LeftButton);
+        QTest::mouseClick(welcome.findChild<QPushButton*>("buttonImport"), Qt::LeftButton);
+        QCOMPARE(createSpy.count(), 1);
+        QCOMPARE(openSpy.count(), 1);
+        QCOMPARE(importSpy.count(), 1);
+        auto recent = welcome.findChild<QListWidget*>("recentListWidget");
+        QCOMPARE(recent->count(), 1);
+        QVERIFY(!recent->item(0)->text().contains(QDir::tempPath()));
+        recent->setCurrentRow(0);
+        recent->setFocus();
+        QTRY_VERIFY(recent->hasFocus());
+        QTest::keyClick(recent, Qt::Key_Return);
+        QVERIFY(!recentSpy.isEmpty());
+        QCOMPARE(recentSpy.first().first().toString(), file);
+        config()->set(Config::RememberLastDatabases, true);
+        QTest::keyClick(recent, Qt::Key_Delete);
+        QCOMPARE(config()->get(Config::LastDatabases).toStringList().size(), 0);
+    }
+
+    void previews_data()
+    {
+        QTest::addColumn<QString>("theme");
+        QTest::newRow("light") << QStringLiteral("light");
+        QTest::newRow("dark") << QStringLiteral("dark");
+    }
+
+    void previews()
+    {
+        QFETCH(QString, theme);
+        config()->set(Config::GUI_ApplicationTheme, theme);
+        config()->set(Config::LastDatabases, QStringList{});
+        config()->set(Config::GUI_MainWindowGeometry, QByteArray());
+        qobject_cast<Application*>(qApp)->applyTheme();
+        if (!m_window) {
+            m_window = std::make_unique<MainWindow>();
+        }
+        auto& window = *m_window;
+        window.setAllowScreenCapture(true);
+        window.show();
+        window.resize(1120, 780);
+        QTest::qWait(80);
+        auto welcome = window.findChild<WelcomeWidget*>("welcomeWidget");
+        QVERIFY(welcome->isVisible());
+        QVERIFY(!window.findChild<QToolBar*>("toolBar")->isVisible());
+        const auto output = qEnvironmentVariable("LOCALVAULT_PREVIEW_DIR");
+        if (!output.isEmpty()) {
+            QVERIFY(QDir().mkpath(output));
+            QVERIFY(window.grab().save(output + "/welcome-" + theme + ".png"));
+            window.resize(800, 560);
+            QTest::qWait(40);
+            const auto create = welcome->findChild<QPushButton*>("buttonNewDatabase");
+            const auto import = welcome->findChild<QPushButton*>("buttonImport");
+            QVERIFY(import->geometry().top() >= create->mapTo(import->parentWidget(), QPoint(0, create->height())).y());
+            QVERIFY(window.grab().save(output + "/welcome-" + theme + "-compact.png"));
+            window.resize(1120, 780);
+        }
+        const auto palette = qApp->palette();
+        if (theme == "dark") {
+            QVERIFY(palette.color(QPalette::Window).lightness() < 80);
+            QVERIFY(palette.color(QPalette::Text).lightness() > 180);
+        } else {
+            QVERIFY(palette.color(QPalette::Window).lightness() > 220);
+            QVERIFY(palette.color(QPalette::Text).lightness() < 80);
+        }
+
+        auto db = QSharedPointer<Database>::create();
+        auto key = QSharedPointer<CompositeKey>::create();
+        key->addKey(QSharedPointer<PasswordKey>::create("SYNTHETIC-PREVIEW-ONLY"));
+        QVERIFY(db->setKey(key, false, false, false));
+        db->metadata()->setName("LocalVault Demo");
+        db->rootGroup()->setName(QStringLiteral("我的账号"));
+        auto web = new Group();
+        web->setName(QStringLiteral("网站账号"));
+        web->setParent(db->rootGroup());
+        auto apps = new Group();
+        apps->setName(QStringLiteral("软件账号"));
+        apps->setParent(db->rootGroup());
+        for (const auto& name : {"GitHub", "Microsoft", "Figma", "Notion", "Steam"}) {
+            auto entry = new Entry();
+            entry->setUuid(QUuid::createUuid());
+            entry->setTitle(QString::fromUtf8(name));
+            entry->setUsername("demo@example.invalid");
+            entry->setPassword("SYNTHETIC-PREVIEW-ONLY");
+            entry->setGroup(db->rootGroup());
+        }
+        db->markAsClean();
+        auto tabs = window.findChild<DatabaseTabWidget*>("tabWidget");
+        auto dbWidget = new DatabaseWidget(db, &window);
+        tabs->addDatabaseTab(dbWidget);
+        dbWidget->setSplitterSizes({{Config::GUI_SplitterState, {240, 850}},
+                                   {Config::GUI_GroupSplitterState, {420, 160}}});
+        QVERIFY(!dbWidget->isLocked());
+        QTest::qWait(80);
+        QVERIFY(window.findChild<QToolBar*>("toolBar")->isVisible());
+        QVERIFY(QMetaObject::invokeMethod(dbWidget->findChild<EntryView*>("entryView"), "fitColumnsToWindow"));
+        if (!output.isEmpty()) {
+            QVERIFY(window.grab().save(output + "/vault-" + theme + ".png"));
+        }
+        auto search = window.findChild<QLineEdit*>("searchEdit");
+        QVERIFY(search);
+        search->setFocus();
+        QTest::keyClicks(search, "GitHub");
+        auto entries = dbWidget->findChild<EntryView*>("entryView");
+        QTRY_COMPARE(entries->model()->rowCount(), 1);
+        search->clear();
+        QTRY_COMPARE(entries->model()->rowCount(), 5);
+        db->markAsClean();
+        QVERIFY(tabs->closeDatabaseTab(0));
+    }
+
+private:
+    QTranslator m_translator;
+    std::unique_ptr<MainWindow> m_window;
+};
+
+int main(int argc, char** argv)
+{
+    Application app(argc, argv);
+    app.setApplicationName("LocalVaultPreviewTest");
+    app.setQuitOnLastWindowClosed(false);
+    TestLocalVaultAppearance test;
+    return QTest::qExec(&test, argc, argv);
+}
+
+#include "TestLocalVaultAppearance.moc"
