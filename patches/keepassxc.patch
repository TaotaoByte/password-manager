+void MainWindow::quickSaveFromWindow(const QString& title)
+{
+    if (QApplication::activeModalWidget()) return;
+    auto dbWidget = m_ui->tabWidget->currentDatabaseWidget();
+    bringToFront();
+    if (!dbWidget) {
+        displayGlobalMessage(QStringLiteral("请先创建或打开密码库，再使用快捷保存。"), MessageWidget::Information);
+        return;
+    }
+    if (dbWidget->isLocked()) {
+        // Keep only the non-secret title while the upstream unlock dialog is open.
+        auto connection = QSharedPointer<QMetaObject::Connection>::create();
+        const QPointer<DatabaseWidget> target(dbWidget);
+        *connection = connect(this, &MainWindow::databaseUnlockDialogFinished, this,
+            [this, connection, target, title](bool accepted, DatabaseWidget* unlocked) {
+                disconnect(*connection);
+                if (accepted && target && target == unlocked) {
+                    QTimer::singleShot(0, this, [this, target, title] {
+                        if (target && m_ui->tabWidget->currentDatabaseWidget() == target) quickSaveFromWindow(title);
+                    });
+                }
+            });
+        m_ui->tabWidget->unlockDatabaseInDialog(dbWidget, DatabaseOpenDialog::Intent::None);
+        return;
+    }
+    if (m_ui->stackedWidget->currentIndex() != DatabaseTabScreen
+        || dbWidget->currentMode() != DatabaseWidget::Mode::ViewMode || dbWidget->isRecycleBinSelected()) {
+        displayGlobalMessage(QStringLiteral("请先结束当前编辑或设置，并选择普通分组，再使用快捷保存。"),
+                             MessageWidget::Information);
+        return;
+    }
+    dbWidget->createEntryForWindow(title);
+}
