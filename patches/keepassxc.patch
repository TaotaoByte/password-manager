+    const QString window = QStringLiteral("登录 *? [账户] - Example.exe");
+    Entry entry;
+    QuickSave::prepareEntry(&entry, window);
+    QCOMPARE(entry.title(), window);
+    QCOMPARE(entry.defaultAutoTypeSequence(), QStringLiteral("{USERNAME}{TAB}{PASSWORD}"));
+    QCOMPARE(entry.autoTypeAssociations()->size(), 1);
+    const auto pattern = entry.autoTypeAssociations()->get(0).window;
+    QRegularExpression regex(pattern.mid(2, pattern.size() - 4));
+    QVERIFY(regex.isValid());
+    QVERIFY(regex.match(window).hasMatch());
+    QVERIFY(!regex.match(QStringLiteral("登录 anything [账户] - Example.exe")).hasMatch());
+    QVERIFY(!regex.match(window + QStringLiteral(" - other")).hasMatch());
+    Entry empty;
+    QuickSave::prepareEntry(&empty, {});
+    QCOMPARE(empty.autoTypeAssociations()->size(), 0);
+}
